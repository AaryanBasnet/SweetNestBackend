# -----------------------------------------------------------------------------
# SweetNest Backend - environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must never be committed.
#
# The server validates the required variables at boot and exits if any are
# missing, so a misconfigured deploy fails immediately instead of failing on
# the first customer request.
# -----------------------------------------------------------------------------

# --- Core (required) ---------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# NOTE: multi-document transactions require a replica set. A standalone
# mongodb:// instance cannot run them. Atlas (mongodb+srv://) always can.
DB_URL=mongodb://localhost:27017/SweetNestDatabase

# Secret used to sign JWTs. Use a long random value, different per environment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Auth (optional) ---------------------------------------------------------
# How long an access token stays valid. Kept short because the token lives in
# browser storage and there is no refresh-token rotation yet.
JWT_EXPIRES_IN=7d

# Separate secret for HMAC-ing password reset codes. Falls back to JWT_SECRET
# when unset. Set it if you ever rotate JWT_SECRET, so outstanding reset codes
# do not all break at once.
RESET_CODE_SECRET=

# --- URLs (required in production) -------------------------------------------
# The frontend origin. In production this is also the CORS allowlist, so it
# must be exact (scheme + host + port, no trailing slash).
FRONTEND_URL=http://localhost:5173

# Public URL of THIS server. eSewa redirects the customer back to it, so it
# must be reachable from the customer's browser - not "localhost" in production.
BACKEND_URL=http://localhost:5000

# Extra CORS origins, comma separated. Use for a staging domain or an ngrok
# tunnel. Leave empty in production unless you genuinely need another origin.
CORS_EXTRA_ORIGINS=

# --- eSewa (required in production) ------------------------------------------
# In development these default to eSewa's public test credentials.
# In production the server refuses to start without real ones.
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=

# --- Email -------------------------------------------------------------------
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (optional) -------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace | silent
# Defaults to debug in development, info in production, silent under test.
LOG_LEVEL=

# Error tracking. Leave blank and Sentry is never initialised - the app runs
# identically without it. Get a DSN from a free project at sentry.io.
SENTRY_DSN=
# Ties an error to the deploy that caused it. Set to the commit SHA in CI.
SENTRY_RELEASE=
# Fraction of requests traced for performance monitoring (0 to 1).
SENTRY_TRACES_SAMPLE_RATE=0.1
